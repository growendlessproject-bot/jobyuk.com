# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080
ENV=development

# Database URL
DATABASE_URL=postgres://jobies:jobies@localhost:5432/jobies?sslmode=disable

# Redis URL
REDIS_URL=redis://localhost:6379/0

# Reed.co.uk API Key (Register at https://www.reed.co.uk/developers)
REED_API_KEY=your_reed_api_key_here

# Security Secrets
JWT_SECRET=generate-a-secure-secret-key-for-jwt-in-production
CSRF_SECRET=generate-a-secure-secret-key-for-csrf-in-production

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
